#!/bin/sh
# removal must continue after optional jailbreak tools disappear

if [ -e /var/jb/.procursus_strapped ] || \
   [ -x /var/jb/basebin/launchctl ] || \
   [ -x /var/jb/usr/bin/dpkg ]; then
  JBROOT=/var/jb
else
  JBROOT=
fi
PLIST=${JBROOT}/Library/LaunchDaemons/com.senko.senkod.plist
SENKOCTL=/var/jb/usr/bin/senkoctl
KILLALL=${JBROOT}/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/bin/killall
LAUNCHCTL=${JBROOT}/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=${JBROOT}/usr/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/usr/bin/launchctl
STATUS_STATE=/var/mobile/Library/Preferences/com.senko.status.state
AWG_ACTIVE=/var/run/senkod-amnezia.config

# routes and the utun belong to the daemon, and dpkg deletes the
# binaries that know how to undo them moments after this script returns. asking
# the daemon to disconnect while it is still on disk is the only clean teardown;
# removing the package over a live tunnel used to leave the device with a
# default route into a utun nobody owned any more, and nothing left installed
# could turn it off again
stop_tunnel() {
  [ -S /var/tmp/senkod.sock ] && [ -x "$SENKOCTL" ] || return 0
  # an upgrade keeps the amneziawg profile recorded, and the new senkod brings
  # it back; anything else ends it for good
  if [ "$1" != upgrade ]; then
    "$SENKOCTL" awg stop >/dev/null 2>&1 || true
  fi
  "$SENKOCTL" disconnect >/dev/null 2>&1 || true
}

# the launchctl of h3lix on ios 10 answers 0 to bootout without doing it, and
# a job left loaded restarts senkod right after the kill below
launchd_loaded() {
  case "$("$LAUNCHCTL" list 2>/dev/null)" in
    *com.senko.senkod*) return 0 ;;
  esac
  return 1
}

stop_daemon() {
  if [ -x "$LAUNCHCTL" ]; then
    "$LAUNCHCTL" bootout "system/com.senko.senkod" >/dev/null 2>&1
    launchd_loaded && "$LAUNCHCTL" bootout system "$PLIST" >/dev/null 2>&1
    launchd_loaded && "$LAUNCHCTL" unload "$PLIST" >/dev/null 2>&1
    launchd_loaded && "$LAUNCHCTL" remove com.senko.senkod >/dev/null 2>&1
    launchd_loaded && echo "senko: launchd still holds com.senko.senkod" >&2
  fi
  # SIGTERM lets senkod drop routes and rules before it exits
  "$KILLALL" -TERM senkod >/dev/null 2>&1 || true
  sleep 1
  "$KILLALL" -TERM senkod >/dev/null 2>&1 || true
  sleep 1
  "$KILLALL" -9 senkod >/dev/null 2>&1 || true
  # the senko-core holds the tunnel descriptor; the kernel drops every route bound
  # to that utun as soon as the last descriptor closes. senko-core is a hard link
  # to the extension binary, so it can run under either name
  "$KILLALL" -9 senko-core SenkoTunnel >/dev/null 2>&1 || true
}

if [ "${SENKO_UPDATE:-0}" != "1" ]; then
  stop_tunnel "$1"
  stop_daemon
fi

printf '0\n' > "$STATUS_STATE" 2>/dev/null || true

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  # plain removal preserves user servers for a later reinstall
  rm -f /var/tmp/senkod.sock /var/tmp/senkod.token >/dev/null 2>&1 || true
  rm -f "$AWG_ACTIVE" >/dev/null 2>&1 || true
  # postinst made this hard link, dpkg does not know it
  rm -f /var/jb/usr/lib/senko-core >/dev/null 2>&1 || true
fi

exit 0
